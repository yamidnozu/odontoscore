---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Simulador 3D de Endodoncia: Longitud de Trabajo sobre malla real";
const pageDesc = "Practica la conductometría en 6 dientes reales (BodyParts3D): diente 3D con lima, regla milimetrada, Rx de conductometría, localizador apical y cámara para control con la mano.";
const canonicalUrl = "https://odontoscore.com/guias/simulador-endodoncia-3d.html";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Simulador 3D de Endodoncia: Longitud de Trabajo sobre malla real",
    "url": canonicalUrl,
    "description": pageDesc,
    "author": { "@type": "Organization", "name": "Comité Clínico OdontoScore" },
    "publisher": {
      "@type": "Organization",
      "name": "OdontoScore",
      "logo": {
        "@type": "ImageObject",
        "url": "https://odontoscore.com/assets/img/logo-odontoscore.svg"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Endo3D Trainer · Longitud de Trabajo",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0" },
    "url": canonicalUrl
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <link rel="stylesheet" href="/styles/simulador-endodoncia.css?v=20260909" />

  <div class="endo-app">
    <nav class="endo-crumb" aria-label="Ruta">
      <a href="/#academia">Academia</a>
      <span aria-hidden="true">/</span>
      <a href="/guias/longitud-trabajo-endodoncia.html">Longitud de trabajo</a>
      <span aria-hidden="true">/</span>
      <span>Simulador 3D</span>
    </nav>

    <header class="endo-hero">
      <div class="hero-badge">Tutor clínico · Endodoncia</div>
      <h1>Simulador 3D de longitud de trabajo</h1>
      <p>
        Elige diente y conducto, introduce la lima por la malla real, toma la Rx de
        conductometría y fija la LT a 0.5–1 mm del foramen. Puedes girar el diente con
        el ratón o controlar la profundidad con la cámara y la pinza pulgar–índice.
      </p>
      <div class="endo-callout">
        <strong>Regla de oro</strong>
        <span>LT = APEX − 0.5 mm. El vértice radiográfico no es el límite de instrumentación.</span>
      </div>
      <div class="endo-hero-links">
        <a href="/guias/longitud-trabajo-endodoncia.html">Abrir la guía clínica →</a>
        <a href="/guias/visor-3d-diente.html">Visor 3D del diente →</a>
      </div>
    </header>

    <ol class="endo-protocol">
      <li><b>Paso 1</b> Elige diente y conducto</li>
      <li><b>Paso 2</b> Gira el 3D o abre la cámara</li>
      <li><b>Paso 3</b> Introduce la lima hasta la LT</li>
      <li><b>Paso 4</b> Toma la Rx de conductometría</li>
      <li><b>Paso 5</b> Fija y comprueba el error</li>
    </ol>

    <div class="endo-board">
      <section class="endo-card endo-viewport">
        <h2>Diente 3D</h2>
        <div class="endo-toolbar seg">
          <button type="button" id="modeSolid" class="ghost mini">Diente completo</button>
          <button type="button" id="modeCanal" class="mini">Ver conducto</button>
          <button type="button" id="modeXray" class="ghost mini">Rayos X</button>
          <button type="button" id="vVest" class="ghost mini">Vestibular</button>
          <button type="button" id="vMes" class="ghost mini">Mesial</button>
          <button type="button" id="vOcl" class="ghost mini">Oclusal</button>
          <button type="button" id="vLing" class="ghost mini">Lingual</button>
        </div>

        <div class="endo-viewwrap">
          <canvas id="view3d" width="1280" height="1040" role="img" aria-label="Diente 3D con lima endodóntica y regla milimetrada"></canvas>
          <div id="orbitHint" class="endo-orbit-hint">Arrastra para girar · rueda para zoom · clic en la regla = lima</div>
        </div>
        <p class="endo-hint">
          El punto de acceso es la cavidad real: la lima entra por ahí. Un dedo gira;
          pellizco o rueda hace zoom; doble clic centra la vista.
        </p>

        <label for="depth">Profundidad desde <span id="refPt">el borde</span>: <b id="depthVal">19.0 mm</b></label>
        <input type="range" id="depth" min="8" max="32" step="0.1" value="19">
        <div class="stepper">
          <button type="button" class="mini ghost" id="dMinus1">−1</button>
          <button type="button" class="mini ghost" id="dMinus">−0.1</button>
          <input type="number" id="depthNum" step="0.1" value="19">
          <button type="button" class="mini ghost" id="dPlus">+0.1</button>
          <button type="button" class="mini ghost" id="dPlus1">+1</button>
        </div>
        <div class="row">
          <button type="button" id="btnIn">Introducir hasta la LT</button>
          <button type="button" id="btnOut" class="ghost">Retirar</button>
        </div>
        <div class="row">
          <button type="button" id="rxInitBtn" class="ghost">1 · Rx inicial</button>
          <button type="button" id="rxBtn">2 · Rx conductometría</button>
        </div>
        <div class="row">
          <button type="button" id="fixBtn">3 · Fijar LT aquí</button>
          <button type="button" id="checkBtn" class="ghost">Comprobar</button>
        </div>
        <div class="row">
          <button type="button" id="resetBtn" class="ghost">Reiniciar</button>
        </div>
      </section>

      <aside class="endo-side">
        <section class="endo-card">
          <h2>1 · Caso</h2>
          <label for="toothSel">Diente (malla 3D oficial)</label>
          <select id="toothSel"></select>
          <label for="canalSel">Conducto</label>
          <select id="canalSel"></select>
          <div class="read" id="toothInfo"></div>
          <div class="read" id="meshInfo"></div>
          <label><input type="checkbox" id="examMode" style="width:auto"> Modo práctica: oculta el ápice y puntúa tu error</label>
          <div class="exam" id="examBox" hidden>Ápice oculto. Usa la Rx y el localizador para hallar la LT y pulsa <b>Comprobar</b>.</div>
          <div class="warnbox" id="noModelBox" hidden>No se pudieron cargar las mallas 3D. Recarga la página.</div>
        </section>

        <section class="endo-card" id="stage">
          <h2>2 · Cámara y mano</h2>
          <p class="endo-hint">
            Pulsa «Usar cámara». Coloca la mano frente a la webcam: la pinza pulgar–índice
            mueve la lima. En la banda verde, mantén 1 s para congelar la medida.
          </p>
          <div class="read" id="gestureInfo">Cámara lista. El permiso se pide al iniciar.</div>
          <div class="row">
            <button type="button" id="btnCam">Usar cámara y manos</button>
            <button type="button" id="btnCamOff" class="ghost" disabled>Detener</button>
          </div>
          <video id="cam" class="endo-cam-src" width="640" height="480" playsinline muted autoplay></video>
          <div id="liveZone" hidden>
            <div class="big" id="stageDepth">19.0 mm</div>
            <div class="endo-cam-preview">
              <canvas id="hands" width="640" height="480" aria-label="Vista de la mano y esqueleto detectado"></canvas>
            </div>
            <div class="frozeBadge" id="frozeBadge" hidden></div>
            <div class="read" id="stageHint">Inicia la cámara para practicar.</div>
            <canvas id="rail" width="600" height="150"></canvas>
            <div class="row">
              <button type="button" id="btnFreeze">Congelar medida</button>
              <button type="button" id="btnUnlock" class="ghost">Seguir ajustando</button>
            </div>
          </div>
        </section>

        <section class="endo-card">
          <h2>Rx de conductometría</h2>
          <canvas id="rx" width="1200" height="760"></canvas>
          <div class="read" id="rxInfo">Sin Rx todavía. Pulsa «1 · Rx inicial».</div>
        </section>

        <section class="endo-card">
          <h2>Localizador apical</h2>
          <div class="big b-corta" id="bigZone">—</div>
          <div class="read">Profundidad: <b id="rDepth">19.0 mm</b> · Punta → foramen: <b id="rDist">?</b> <span class="badge b-corta" id="rZone">—</span></div>
          <div class="read">Lectura: <b id="rApex">—</b></div>
          <div id="apexBar"><div id="apexFill"></div></div>
          <div class="formula">Corrección: <b id="rCorr">—</b></div>
          <div class="read" id="result"></div>
        </section>

        <section class="endo-card">
          <h2>Protocolo</h2>
          <ol class="steps" id="steps">
            <li data-s="rx0">Mira la Rx inicial y estima la longitud</li>
            <li data-s="lima">Introduce la lima (≈ estimación − 1 mm)</li>
            <li data-s="rx1">Toma la Rx de conductometría</li>
            <li data-s="lt">Ajusta a 0.5–1 mm corta y fija la LT</li>
          </ol>
        </section>

        <section class="endo-card">
          <h2>Mi progreso</h2>
          <div class="read" id="stats">Sin intentos todavía.</div>
          <ol class="steps" id="history"></ol>
          <div class="read" id="cfgState">La configuración se guarda en este navegador.</div>
          <div class="row">
            <button type="button" id="resetCfg" class="ghost">Restablecer valores de fábrica</button>
          </div>
          <details>
            <summary>Avanzado: lima, margen y vista</summary>
            <label for="fileSel">Lima K</label>
            <select id="fileSel">
              <option>#08</option>
              <option>#10</option>
              <option selected>#15 (inicial habitual)</option>
              <option>#20</option>
              <option>#25</option>
            </select>
            <label for="marginSel">Margen foramen → CDC</label>
            <select id="marginSel">
              <option value="0.5">0.5 mm (estándar)</option>
              <option value="1">1.0 mm (curvo / reabsorción)</option>
            </select>
            <label>Rotación horizontal: <b id="rxVal">−18°</b></label>
            <div class="stepper">
              <button type="button" class="mini ghost" id="rxMinus">−1°</button>
              <input type="range" id="rotX" min="-90" max="90" step="1" value="-18">
              <input type="number" id="rotXNum" step="1" value="-18" style="max-width:70px">
              <button type="button" class="mini ghost" id="rxPlus">+1°</button>
            </div>
            <label>Rotación vertical: <b id="ryVal">24°</b></label>
            <div class="stepper">
              <button type="button" class="mini ghost" id="ryMinus">−1°</button>
              <input type="range" id="rotY" min="-180" max="180" step="1" value="24">
              <input type="number" id="rotYNum" step="1" value="24" style="max-width:70px">
              <button type="button" class="mini ghost" id="ryPlus">+1°</button>
            </div>
            <label>Zoom: <b id="zoomVal">1.0×</b></label>
            <input type="range" id="zoom" min="0.5" max="4" step="0.1" value="1">
            <label>Corte: <b id="clipVal">45%</b></label>
            <input type="range" id="clip" min="0" max="90" step="5" value="45">
            <label>Transparencia: <b id="opVal">100%</b></label>
            <input type="range" id="opac" min="15" max="100" step="5" value="100">
            <div class="presets">
              <button type="button" id="vWire" class="ghost mini">Malla on/off</button>
            </div>
          </details>
        </section>
      </aside>
    </div>

    <p class="endo-note">
      Herramienta educativa con mallas BodyParts3D calibradas al promedio clínico — verifica
      siempre en clínica. Progreso guardado solo en tu navegador. Mallas: BodyParts3D © The
      Database Center for Life Science, licencia CC BY 4.0.
    </p>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var wrap = document.querySelector('.endo-viewwrap');
      var hint = document.getElementById('orbitHint');
      if (!wrap || !hint) return;
      var hide = function () { hint.classList.add('is-hidden'); };
      wrap.addEventListener('pointerdown', hide, { capture: true });
      wrap.addEventListener('wheel', hide, { capture: true, passive: true });
    });
  </script>
  <script is:inline src="/simuladores/endodoncia/vision-engine.js?v=20260909cam" defer></script>
  <script is:inline src="/simuladores/endodoncia/data/models.js?v=20260909cam" defer></script>
  <script is:inline src="/simuladores/endodoncia/engine.js?v=20260909cam" defer></script>
</BaseLayout>
