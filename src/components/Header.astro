---
import CurrencySelector from './CurrencySelector';
import { mainNavigation } from '../config/navigation';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

function isItemActive(href: string): boolean {
  if (href === '/' || href.startsWith('/#')) return false;
  const cleanHref = href.replace('.html', '').replace(/\/$/, '');
  return currentPath.includes(cleanHref);
}

function isDropdownActive(item: typeof mainNavigation[0]): boolean {
  if (item.children) {
    return item.children.some(child => isItemActive(child.href));
  }
  return false;
}
---

<header class="site-header" id="siteHeader">
  <div class="container nav-wrapper">
    <a href="/" class="brand-logo" title="OdontoScore - Portal Odontológico">
      <img src="/assets/img/logo-odontoscore.svg" alt="OdontoScore" height="38" class="logo-img" />
    </a>

    <button type="button" class="mobile-menu-toggle" id="mobileMenuBtn" aria-label="Menú">
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" id="mainNav">
      <ul class="nav-links">
        {mainNavigation.map((item) => {
          const hasChildren = item.children && item.children.length > 0;
          const activeDropdown = hasChildren ? isDropdownActive(item) : false;
          const activeLink = !hasChildren ? isItemActive(item.href) : false;

          if (hasChildren) {
            return (
              <li class="nav-item-dropdown">
                <a
                  href={item.href}
                  class={`nav-link-dropdown ${activeDropdown ? 'active' : ''}`}
                  data-nav={item.navKey}
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  {item.label}
                  <svg class="dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                <div class="nav-dropdown-menu">
                  {item.children!.map((child) => (
                    <a
                      href={child.href}
                      class={`dropdown-link ${isItemActive(child.href) ? 'active' : ''}`}
                      style={child.highlight ? "color:#0284C7;font-weight:700;" : undefined}
                    >
                      {child.label}
                    </a>
                  ))}
                  {item.viewAll && (
                    <>
                      <div class="dropdown-divider"></div>
                      <a href={item.viewAll.href} class="dropdown-link-all">
                        {item.viewAll.label}
                      </a>
                    </>
                  )}
                </div>
              </li>
            );
          }

          return (
            <li>
              <a
                href={item.href}
                data-nav={item.navKey}
                class={activeLink ? 'active' : ''}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="nav-actions">
        <!-- React Island: CurrencySelector -->
        <CurrencySelector client:load />

        <a href="/comparador.html" class="btn-nav-compare" id="headerCompareBtn">
          <span>Comparar Modelos</span>
          <span class="compare-badge" id="compareCountBadge" style="display:none">0</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function initHeaderNav() {
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const mainNav = document.getElementById('mainNav');
    const siteHeader = document.getElementById('siteHeader');

    // Mobile drawer toggle
    if (mobileBtn && mainNav) {
      mobileBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = mainNav.classList.toggle('open');
        mobileBtn.classList.toggle('active', isOpen);
        if (siteHeader) siteHeader.classList.toggle('menu-open', isOpen);
      });
    }

    // Universal Dropdown click/tap handling (transversal para desktop, tablets y mobile)
    const dropdownItems = document.querySelectorAll<HTMLElement>('.nav-item-dropdown');
    dropdownItems.forEach((dropdown) => {
      const trigger = dropdown.querySelector<HTMLAnchorElement>('.nav-link-dropdown');
      if (trigger) {
        trigger.addEventListener('click', (e) => {
          const isMobile = window.innerWidth <= 900;
          const isOpen = dropdown.classList.contains('open');

          // Cerrar otros dropdowns abiertos
          dropdownItems.forEach((d) => {
            if (d !== dropdown) {
              d.classList.remove('open');
              d.querySelector('.nav-link-dropdown')?.setAttribute('aria-expanded', 'false');
            }
          });

          if (isMobile) {
            // En pantallas móviles/táctiles siempre prevenimos navegación para expandir la lista
            e.preventDefault();
            dropdown.classList.toggle('open');
            trigger.setAttribute('aria-expanded', dropdown.classList.contains('open') ? 'true' : 'false');
          } else {
            // En desktop/pantallas anchas: si se hace click en el botón desplegable
            if (!isOpen) {
              e.preventDefault();
              dropdown.classList.add('open');
              trigger.setAttribute('aria-expanded', 'true');
            }
          }
        });
      }
    });

    // Cerrar dropdown al hacer click fuera del menú
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && !target.closest('.nav-item-dropdown')) {
        dropdownItems.forEach((dropdown) => {
          dropdown.classList.remove('open');
          dropdown.querySelector('.nav-link-dropdown')?.setAttribute('aria-expanded', 'false');
        });
      }
    });

    // Cerrar al presionar tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdownItems.forEach((dropdown) => {
          dropdown.classList.remove('open');
          dropdown.querySelector('.nav-link-dropdown')?.setAttribute('aria-expanded', 'false');
        });
        if (mainNav && mainNav.classList.contains('open')) {
          mainNav.classList.remove('open');
          mobileBtn?.classList.remove('active');
          if (siteHeader) siteHeader.classList.remove('menu-open');
        }
      }
    });

    // Cerrar menú mobile al hacer click en cualquier enlace interno
    const navLinks = mainNav?.querySelectorAll<HTMLAnchorElement>('a:not(.nav-link-dropdown)');
    navLinks?.forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 900 && mainNav) {
          mainNav.classList.remove('open');
          mobileBtn?.classList.remove('active');
          if (siteHeader) siteHeader.classList.remove('menu-open');
        }
      });
    });
  }

  // Inicializar en carga y tras navegaciones de Astro
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderNav);
  } else {
    initHeaderNav();
  }
  document.addEventListener('astro:page-load', initHeaderNav);
</script>
