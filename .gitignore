# ==========================================
# OdontoScore — .gitignore
# ==========================================

# ── Environment & Secrets ──
.env
.env.local
.env.*.local
.env.production

# ── Node / Astro / Dependencies ──
node_modules/
dist/
.astro/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Python & Virtual Environments ──
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
*.egg-info/
.pytest_cache/

# ── Archives & Backups ──
*.zip
*.tar.gz
*.tgz
*.7z

# ── Logs & Debug ──
*.log

# ── OS & IDE Metadata ──
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
.agents/
*.sublime-project
*.sublime-workspace
node_modules/*
**/node_modules/**