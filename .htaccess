# OdontoScore — Caching, Security & SEO Rewrite Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Clean URL rewrites → index.html with hash
  RewriteRule ^catalogo/?$ /index.html#catalogo [NE,L,R=302]
  RewriteRule ^estudiantes/?$ /index.html#estudiantes [NE,L,R=302]
  RewriteRule ^comparador/?$ /index.html#comparador [NE,L,R=302]
  RewriteRule ^ofertas/?$ /index.html#ofertas [NE,L,R=302]
  RewriteRule ^faq/?$ /index.html#faq [NE,L,R=302]
</IfModule>

# Cache-Control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|svg|png|jpg)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
